generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  age      Int
  city     String?
}

model Todo {
  id Int @default(autoincrement()) @id
  title String
  description String
  userId  Int
  done  Boolean
}
